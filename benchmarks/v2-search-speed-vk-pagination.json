{
  "name": "v2-search-speed-vk-pagination",
  "description": "Source-scoped live benchmark for VK career API pagination changes. Use this profile when changing career:vk pagination so unrelated catalog volatility cannot affect the decision.",
  "min_wall_speedup": 0.1,
  "shape_policy": "at_least_baseline",
  "shape_sources": [
    "career:vk"
  ],
  "max_wall_seconds": 15.0,
  "max_source_elapsed_ms": 15000,
  "runs_dir": ".job-harness/v2/benchmarks/runs",
  "result_dir": ".job-harness/v2/benchmarks/results",
  "runner": [
    "uv",
    "--directory",
    "plugins/job-harness",
    "run",
    "job-harness-v2"
  ],
  "search_args": [
    "search",
    "--query",
    "Quality Assurance",
    "--grade",
    "middle",
    "--grade",
    "senior",
    "--published-since",
    "2026-06-01",
    "--work-format",
    "remote",
    "--remote-scope",
    "country:RU",
    "--vacancy-geography",
    "country:RU",
    "--source",
    "career:vk"
  ]
}
