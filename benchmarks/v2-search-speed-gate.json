{
  "name": "v2-search-speed-gate-qa-lite",
  "description": "Bounded live v2 search profile for speed-regression checks. This intentionally avoids detail-heavy sources that throttle repeated benchmark runs.",
  "min_wall_speedup": 0.1,
  "shape_policy": "exact",
  "max_wall_seconds": 30.0,
  "max_source_elapsed_ms": 15000,
  "runs_dir": ".job-harness/v2/benchmarks/runs",
  "result_dir": ".job-harness/v2/benchmarks/results",
  "runner": [
    "uv",
    "--directory",
    "plugins/job-harness",
    "run",
    "job-harness-v2"
  ],
  "search_args": [
    "search",
    "--query",
    "Quality Assurance",
    "--grade",
    "middle",
    "--grade",
    "senior",
    "--published-since",
    "2026-06-01",
    "--work-format",
    "remote",
    "--remote-scope",
    "country:RU",
    "--vacancy-geography",
    "country:RU",
    "--source",
    "hh_ru",
    "--source",
    "habr_career",
    "--source",
    "talanto",
    "--source",
    "hirify",
    "--source",
    "hirehi",
    "--source",
    "staff_am",
    "--source",
    "career:clickhouse",
    "--source",
    "career:chainstack",
    "--source",
    "career:unlimint",
    "--source",
    "career:wrike",
    "--source",
    "career:pandadoc",
    "--source",
    "career:visa",
    "--source",
    "career:jetbrains",
    "--source",
    "career:ramp"
  ]
}
