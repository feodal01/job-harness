{
  "name": "v2-search-speed-vk-multi-query",
  "description": "Source-scoped live benchmark for VK career API query-variant fan-out. Use this profile when changing career:vk request mapping so duplicate raw fetches can decrease while presentation rows stay stable.",
  "min_wall_speedup": 0.1,
  "shape_policy": "presentation_at_least",
  "shape_sources": [
    "career:vk"
  ],
  "max_wall_seconds": 15.0,
  "max_source_elapsed_ms": 15000,
  "runs_dir": ".job-harness/v2/benchmarks/runs",
  "result_dir": ".job-harness/v2/benchmarks/results",
  "runner": [
    "uv",
    "--directory",
    "plugins/job-harness",
    "run",
    "job-harness-v2"
  ],
  "search_args": [
    "search",
    "--queries",
    "Quality Assurance | QA Engineer | SDET",
    "--grade",
    "middle",
    "--grade",
    "senior",
    "--published-since",
    "2026-06-01",
    "--remote-mode",
    "compatible-remote",
    "--work-from",
    "RU",
    "--vacancy-geography",
    "RU",
    "--source",
    "career:vk"
  ]
}
