{
  "name": "v2-search-speed-detail-hirify",
  "description": "Source-scoped live benchmark for Hirify detail-enrichment pacing changes. Use this profile when changing Hirify detail delay or concurrency so unrelated source volatility cannot affect the decision.",
  "min_wall_speedup": 0.1,
  "shape_policy": "at_least_baseline",
  "shape_sources": [
    "hirify"
  ],
  "max_wall_seconds": 20.0,
  "max_source_elapsed_ms": 15000,
  "runs_dir": ".job-harness/v2/benchmarks/runs",
  "result_dir": ".job-harness/v2/benchmarks/results",
  "runner": [
    "uv",
    "--directory",
    "plugins/job-harness",
    "run",
    "job-harness-v2"
  ],
  "search_args": [
    "search",
    "--queries",
    "Quality Assurance | QA Engineer | SDET",
    "--grade",
    "middle",
    "--grade",
    "senior",
    "--published-since",
    "2026-06-01",
    "--work-format",
    "remote",
    "--remote-scope",
    "country:RU",
    "--vacancy-geography",
    "country:RU",
    "--source",
    "hirify"
  ]
}
